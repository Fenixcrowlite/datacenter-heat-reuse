  "functions": [
    {
      "names": [
        "tok_dc_bazen"
      ],
      "source": "function [Tnovy,termostat,meranie] = tok_dc_bazen(T,stav,u)\n%#codegen\n% Vsetky vykony vo W; jeden krok = jedna hodina. 500 m3 vody.\n% u: [QDC, Tzdroj, aktivita, plachta, QDH_zad, QTES_zad, povolene, STOP, Tvzduch, RH]\ndt=3600; C=997*500*4182; cp=4182; A=312.5; UA=800;\nqdc=max(0,u(1)); ts=u(2); aktivita=max(0,u(3)); plachta=min(1,max(0,u(4)));\nqdh_p=max(0,u(5)); qtes_p=max(0,u(6));\npovolene=(u(7)>0.5); stop=(u(8)>0.5);\ntair=u(9); rh=min(1,max(0,u(10)));\npv=0.61094*exp(17.625*T/(T+243.04));\npa=rh*0.61094*exp(17.625*tair/(tair+243.04));\nmpar=max(0,4e-5*A*(pv-pa)*aktivita*(1-0.90*plachta));\nQvypar=mpar*2440000;\nQkonv=3*A*(T-tair)*(1-0.75*plachta);\nQrad=0.95*5.670374419e-8*A*((T+273.15)^4-(tair-2+273.15)^4)*(1-0.75*plachta);\nQkonstr=UA*(T-20);\nQdop=mpar*cp*(T-15);\nQstraty=Qvypar+Qkonv+Qrad+Qkonstr+Qdop+2000;\n% Dvojpolohovy termostat + nezavisla teplotna poistka (28 C).\ntermostat=stav;\nif T<=27.35\n    termostat=1;\nelseif T>=27.65\n    termostat=0;\nend\nQpool=0; Qzdroj=0; Pel=0; Qdh=0; Qtes=0; Qodpad=qdc; rezim=0; cop=0;\nif ~stop\n    if povolene && termostat>0.5 && T<27.75\n        % Nad 27.75 C nedovolime dalsi ohrev, aj pri chybe merania.\n        % Maximalny vykon pre 1h krok vratane vypocitanych strat:\n        Qbezpecne=max(0,(27.75-T)*C/dt + Qstraty);\n        Qziad=min(150000,Qbezpecne);\n        Qhxmax=min([qdc,150000,max(0,8500*(ts-T-3))]);\n        if Qhxmax>=0.70*Qziad && Qhxmax>0\n            Qpool=min(Qziad,Qhxmax);\n            Qzdroj=Qpool;\n            rezim=1; % priamy vymennik\n        elseif ts>=5 && qdc>0\n            % Zjednoduseny Carnotov COP s rezervou pristupovych teplot.\n            Tevap=ts-5+273.15;\n            Tcond=max(34,T+8)+273.15;\n            cop=min(6,max(2.5,0.43*Tcond/max(5,Tcond-Tevap)));\n            Qmaxzdroj=qdc/(1-1/cop);\n            Qpool=min([Qziad,150000,Qmaxzdroj,35000*cop]);\n            Pel=Qpool/cop; Qzdroj=Qpool-Pel;\n            rezim=2; % tepelne cerpadlo\n        end\n    end\n    Qdh=min(qdh_p,max(0,qdc-Qzdroj));\n    Qtes=min(qtes_p,max(0,qdc-Qzdroj-Qdh));\n    Qodpad=max(0,qdc-Qzdroj-Qdh-Qtes);\nend\nTnovy=T+(Qpool-Qstraty)*dt/C;\n% Teplotny strop so samostatnou kontrolou - nie tvrdenie o certifikacii.\nmeranie=zeros(1,12);\nmeranie(1)=Tnovy; meranie(2)=Qpool; meranie(3)=Qstraty;\nmeranie(4)=Qzdroj; meranie(5)=Pel; meranie(6)=Qdh;\nmeranie(7)=Qtes; meranie(8)=Qodpad; meranie(9)=rezim;\nmeranie(10)=cop; meranie(11)=Qvypar; meranie(12)=qdc;\nend\n",
      "xml": "simulink/stateflow/chart_11.xml",
      "sha256": "3ebe5cd123c6876340deae991f44d9ff75fd3b90e7af7e25def057210f001096"
    }
  ],
