  "functions": [
    {
      "names": [
        "krok_bazen_v85"
      ],
      "source": "function [Tnovy,stav_novy,y] = krok_bazen_v85(T,stav,u)\n%#codegen\n% Vstup: [Q_HP_sluzba_v85_W, STOP, aktivita, plachta, T_vzduch, RH].\n% Len presmerovanie uz vyrobeneho tepla v85: nie nove teplo z DC!\nC=997*500*4182; dt=900; A=312.5; cp=4182;\nQv85=max(0,u(1)); stop=u(2)>0.5;\naktivita=max(0,u(3)); plachta=min(1,max(0,u(4)));\nTa=u(5);RH=min(1,max(0,u(6)));\nps=0.61094*exp(17.625*T/(T+243.04));\npa=RH*0.61094*exp(17.625*Ta/(Ta+243.04));\nmv=max(0,4e-5*A*(ps-pa)*aktivita*(1-0.9*plachta));\nQvypar=mv*2440000;\nQkonv=3*A*(T-Ta)*(1-0.75*plachta);\nQrad=0.95*5.670374419e-8*A*((T+273.15)^4-(Ta-2+273.15)^4)*(1-0.75*plachta);\nQkonstr=800*(T-20);\nQdop=mv*cp*(T-15);\nQstraty=Qvypar+Qkonv+Qrad+Qkonstr+Qdop+2000;\nstav_novy=stav;\nif T<=27.35\n    stav_novy=1;\nelseif T>=27.65\n    stav_novy=0;\nend\nQpool=0;\nif ~stop && stav_novy>0.5 && T<27.75\n    Qsafe=max(0,C*(27.75-T)/dt+Qstraty);\n    Qpool=min([Qv85,150000,Qsafe]);\nend\n% Zostavajuca sluzba je stale dostupna povodnej vetve.\nQdh=Qv85-Qpool;\nTnovy=T+(Qpool-Qstraty)*dt/C;\ny=zeros(1,9);\ny(1)=Tnovy;y(2)=Qpool;y(3)=Qdh;y(4)=Qstraty;\ny(5)=Qv85;y(6)=double(stop);y(7)=stav_novy;\ny(8)=Qvypar;y(9)=Qv85-(Qpool+Qdh);\nend\n",
      "xml": "simulink/stateflow/chart_11.xml",
      "sha256": "5d16b64e95a24c7fb1160fa6715be0521773cfd498c94be01e269d9251e9087c"
    }
  ],
