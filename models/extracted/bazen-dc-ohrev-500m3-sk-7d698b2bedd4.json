  "functions": [
    {
      "names": [
        "strata"
      ],
      "source": "function [Q_straty,Q_vypar,Q_konstrukcia] = strata(T_voda,aktivita,plachta)\n\n\n%#codegen\n\n\n% Fyzikalne rovnice, jednotky: W, degC, kg/s, Pa/kPa.\n\n\nA=312.5; h=3; UA=800; cp=4182;\n\n\npvoda=0.61094*exp(17.625*T_voda/(T_voda+243.04));\n\n\npvzduch=0.60*0.61094*exp(17.625*29/(29+243.04));\n\n\nmvypar=max(0,4e-5*A*(pvoda-pvzduch)*aktivita*(1-0.90*plachta));\n\n\nQ_vypar=mvypar*2440000;\n\n\nQ_konv=3*A*(T_voda-29)*(1-0.75*plachta);\n\n\nQ_rad=0.95*5.670374419e-8*A*((T_voda+273.15)^4-(27+273.15)^4)*(1-0.75*plachta);\n\n\nQ_konstrukcia=UA*(T_voda-20);\n\n\nQ_doplnanie=mvypar*cp*(T_voda-15);\n\n\nQ_straty=Q_vypar+Q_konv+Q_rad+Q_konstrukcia+Q_doplnanie+2000;\n\n\nend",
      "xml": "simulink/stateflow/chart_11.xml",
      "sha256": "63586385ed0a6789589d5fdbd6bbbec0de0eae35f930656a3027e31008c3a432"
    }
  ],
