  "functions": [
    {
      "names": [
        "dispatch"
      ],
      "source": "function [hp,backup,unmet,mode] = dispatch(demand,potential)\n%#codegen\nhp=min(max(potential,0),max(demand,0));\nbackup=min(2,max(0,demand-hp));\nunmet=max(0,demand-hp-backup);\nmode=double(unmet>0)*2+double(unmet==0 && backup>0);\nend",
      "xml": "simulink/stateflow/chart_11.xml",
      "sha256": "9dc08624f9abeced96816d5ba9b5ed278ec13a1be1611f1ecd46ba14912ce389"
    }
