  "functions": [
    {
      "names": [
        "hp_adapter"
      ],
      "source": "function u=hp_adapter(x,E,p,h)\n%#codegen\ncoder.extrinsic('dchr_stateflow_hp_v22');\nu=zeros(8,1);\nu=dchr_stateflow_hp_v22(x,E,p,h);\nend\n",
      "xml": "simulink/stateflow/chart_61.xml",
      "sha256": "e0bbf32570b6c48983d6e8a6d5c800304706ac60d1d82ff5bfb49fb37ae06039"
    },
    {
      "names": [
        "stateflow_choose_mode_v22"
      ],
      "source": "function mode = stateflow_choose_mode_v22(u,E,p)\n%#codegen\n% Highest service condition; BACKUP/UNMET can include HP and TES discharge.\n% u = [demand, HP heat, electricity, source used, request, COP, available, unused]\n% p = [dt_h, capacity, charge limit, discharge limit, etaC, etaD, loss/h, boiler]\nafter=E*(1-p(7)*p(1));\ndirect=min(u(1),u(2));\ndischarge=min([max(0,u(1)-direct),p(4),after*p(6)/p(1)]);\nremaining=max(0,u(1)-direct-discharge);\nif remaining>p(8)\n    mode=5;\nelseif remaining>0\n    mode=4;\nelseif discharge>0\n    mode=3;\nelseif u(2)>direct\n    mode=2;\nelseif direct>0\n    mode=1;\nelse\n    mode=0;\nend\nend\n",
      "xml": "simulink/stateflow/chart_71.xml",
      "sha256": "dd6c8ec93f7c0d112130b1122d1f48646ce84e52b51e019d4a5fed496f7a2da1"
    },
    {
      "names": [
        "stateflow_allocate_v22"
      ],
      "source": "function y = stateflow_allocate_v22(mode,u,E,p)\n%#codegen\n% Called by the active Stateflow state's entry and during actions.\n% States determine which TES/backup/unmet ports may operate.\ndt=p(1); after=E*(1-p(7)*dt);\ndirect=0; charge=0; discharge=0; gas=0; unmet=0;\nif mode>=1\n    direct=min(u(1),u(2));\nend\nif mode==2\n    charge=min([max(0,u(2)-direct),p(3),(p(2)-after)/dt/p(5)]);\nend\nif mode>=3\n    discharge=min([max(0,u(1)-direct),p(4),after*p(6)/dt]);\nend\nif mode>=4\n    gas=min(p(8),max(0,u(1)-direct-discharge));\nend\nif mode==5\n    unmet=max(0,u(1)-direct-discharge-gas);\nend\nnext=min(p(2),max(0,after+p(5)*charge*dt-discharge*dt/p(6)));\nstanding=E-after;\nchargeLoss=(1-p(5))*charge*dt;\ndischargeLoss=discharge*dt/p(6)-discharge*dt;\nsupplied=direct+discharge+gas;\nresidual=(u(4)+u(3)+gas)*dt+E-supplied*dt-next-standing-chargeLoss-dischargeLoss;\ny=[mode;direct;charge;discharge;gas;unmet;after;next;standing;chargeLoss;dischargeLoss;supplied;residual];\nend\n",
      "xml": "simulink/stateflow/chart_71.xml",
      "sha256": "d61e9a44241c9efd8c793e6777612946cbd3b1bbeaef699ba58da1e25d966565"
