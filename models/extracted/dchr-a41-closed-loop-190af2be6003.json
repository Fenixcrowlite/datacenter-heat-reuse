  "functions": [
    {
      "names": [
        "f_plant"
      ],
      "source": "function [Tnew,shed,rejected,unhandled,dcResidual,passive] = f_plant(qdc,hx,leak,sourceNew,required,cap,mode,Tprev,prevShed)\n%#codegen\ndt=900;\nif mode==1 || mode==2\n    ceiling=.4;\nelse\n    ceiling=0;\nend\ntarget=min([max(0,required-cap),ceiling*qdc,required]);\nif ceiling>0\n    shed=min(target,min(prevShed,qdc)+15000);\nelse\n    shed=0;\nend\nrejected=min(required-shed,cap);\nunhandled=max(0,required-shed-rejected);\npassive=2000*max(0,Tprev-30);\nTnew=max(30,Tprev+dt*(unhandled-passive)/8e6);\ndcResidual=qdc-shed-hx-sourceNew-leak-rejected-unhandled;",
      "xml": "simulink/stateflow/chart_24.xml",
      "sha256": "002bc14fc12b929050231a8ae078d77fa4d82f0bc7f6b1877c82f14c10ca8d0e"
    },
    {
      "names": [
        "f_tes"
      ],
      "source": "function [required,Enew,sourceNew,tesResidual] = f_tes(qcharge,qdis,qpool,qdh,pold,qsourceold,qrejectbase,E)\n%#codegen\ndt=900; Emax=900*3.6e6;\nloss=.002*E/86400;\nroom=max(0,(Emax-E+dt*(qdis/.91+loss))/(dt*.93));\ncharge=min(qcharge,room);\nEnew=max(0,min(Emax,E+dt*(.93*charge-qdis/.91-loss)));\noldCond=qpool+qdh+qcharge;\nnewCond=oldCond-(qcharge-charge);\nif oldCond>1e-8\n    newPower=pold*newCond/oldCond;\nelse\n    newPower=0;\nend\nsourceNew=newCond-newPower;\nrequired=max(0,qrejectbase+qsourceold-sourceNew);\ntesResidual=Enew-E-dt*(.93*charge-qdis/.91-loss);",
      "xml": "simulink/stateflow/chart_44.xml",
      "sha256": "c33500c2725903dd239520ab7b487b4a3c7fff76052ff0c26c4fce6011cf4fba"
    }
